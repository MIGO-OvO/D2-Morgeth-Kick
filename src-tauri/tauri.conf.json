{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D2 Morgath Kick",
  "version": "0.2.1",
  "identifier": "dev.d2morgathkick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "D2 Morgath Kick",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "D2 Morgath Kick 悬浮窗",
        "url": "index.html?view=overlay",
        "width": 470,
        "height": 62,
        "x": 24,
        "y": 24,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 MIGO_12",
    "shortDescription": "D2 Morgath Kick 动作校准工具",
    "longDescription": "检查并调整一套可随时中止、支持按键映射的键鼠动作序列。"
  }
}
